# QuizApp API Environment Variables
# Copy to .env.api and fill in your values:  cp .env.api.template .env.api

# ── Database (MongoDB Atlas) ──
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/quizapp?retryWrites=true&w=majority"

# ── JWT ──
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
JWT_EXPIRY=7d

# ── Server ──
PORT=3002
NODE_ENV=production

# ── Blockchain ──
BLOCKCHAIN_CHAIN=LTC
BLOCKCHAIN_NETWORK=regtest
BLOCKCHAIN_URL=http://localhost:1031

# ── Module Specs (update after contract deployment) ──
NEXT_PUBLIC_TEACHER_MOD_SPEC=
NEXT_PUBLIC_STUDENT_MOD_SPEC=
NEXT_PUBLIC_QUIZ_MOD_SPEC=
NEXT_PUBLIC_QUIZ_ATTEMPT_MOD_SPEC=
NEXT_PUBLIC_PAYMENT_MOD_SPEC=
NEXT_PUBLIC_QUIZ_ACCESS_MOD_SPEC=
NEXT_PUBLIC_QUIZ_ACCESS_SALE_MOD_SPEC=

# ── CORS ──
CORS_ORIGIN=http://localhost:3000

# ── Indexer ──
INDEXER_ENABLED=true
INDEXER_INTERVAL_MS=30000
