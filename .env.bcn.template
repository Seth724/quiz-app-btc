# Bitcoin Computer Node Configuration
# This matches your Bitcoin Computer repo's .env file
# Copy this to .env.bcn for Docker deployment

# ───────────────────────────────────────
# Chain Configuration
# ───────────────────────────────────────
BCN_CHAIN=LTC
BCN_NETWORK=regtest

# ───────────────────────────────────────
# PostgreSQL Configuration
# ───────────────────────────────────────
POSTGRES_USER=bcn
POSTGRES_PASSWORD=bcn
POSTGRES_DB=bcn
POSTGRES_HOST=bcn-db
POSTGRES_PORT=5432
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_IDLE_TIMEOUT_MILLIS=3000

# ───────────────────────────────────────
# Bitcoin Node Configuration (LTC Regtest)
# ───────────────────────────────────────
BITCOIN_IMAGE=bcdb/litecoind-regtest:0.21.2.2
BITCOIN_DATA_DIR=/home/litecoin/.litecoin
BITCOIN_CONF_FILE=litecoin.conf

# RPC Credentials
BITCOIN_RPC_USER=bcn-admin
BITCOIN_RPC_PASSWORD=kH4nU5Okm6-uyC0_mA5ztVNacJqZbYd_KGLl6mx722A=
BITCOIN_RPC_HOST=bcn-node
BITCOIN_RPC_PORT=19332
BITCOIN_P2P_PORT=19444
BITCOIN_RPC_PROTOCOL=http
BITCOIN_DEFAULT_WALLET=defaultwallet

# ───────────────────────────────────────
# BCN Node Configuration
# ───────────────────────────────────────
BCN_PORT=1031
BCN_ZMQ_URL=tcp://bcn-node:28332
BCN_ZMQ_PORT=28332
BCN_ZMQ_ACTIVATION_HEIGHT=1
BCN_URL=http://bcn:1031
BCN_ALLOWED_RPC_METHODS='^get|^gen|^send|^lis'
BCN_ENV=dev
BCN_LOG_LEVEL=4
BCN_LOG_MAX_FILES=14d
BCN_LOG_MAX_SIZE=20m
BCN_LOG_ZIP=false
BCN_SHOW_DB_LOGS=false

# Rate Limiting
BCN_RATE_LIMIT_ENABLED=false
BCN_RATE_LIMIT_WINDOW=900000
BCN_RATE_LIMIT_MAX=300

# ───────────────────────────────────────
# Docker Images
# ───────────────────────────────────────
BITCOIN_IMAGE=bcdb/litecoind-regtest:0.21.2.2
