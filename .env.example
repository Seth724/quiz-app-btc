# Bitcoin Computer Configuration for Public Node
# Copy this file to .env and update the values as needed

# Chain type (BSV is recommended for Bitcoin Computer)
NEXT_PUBLIC_CHAIN=BSV

# Network to use (testnet for testing, mainnet for production)
NEXT_PUBLIC_NETWORK=testnet

# Public Bitcoin Computer node URL (no need to run your own node)
NEXT_PUBLIC_URL=https://public.tbc.ninja

# Derivation path for wallet (standard Bitcoin Computer path)
NEXT_PUBLIC_PATH=m/44'/236'/0'/0/0

# This will be automatically set after deployment - leave empty initially
NEXT_PUBLIC_COUNTER_MOD_SPEC=

# Note: No MNEMONIC needed - it will be auto-generated by the Computer class