# QuizApp Web Environment Variables
# Copy to .env.web and fill in your values:  cp .env.web.template .env.web
#
# IMPORTANT: These variables are baked into the JavaScript bundle at build time.
# After changing this file, you MUST rebuild the web image:
#   set -a && source .env.web && set +a
#   docker compose -f docker-compose.prod.yml build quiz-web
#   docker compose -f docker-compose.prod.yml up -d quiz-web

# ── Blockchain ──
NEXT_PUBLIC_CHAIN=LTC
NEXT_PUBLIC_NETWORK=regtest
# REPLACE WITH YOUR VPS PUBLIC IP (e.g., http://34.93.217.29:1031)
NEXT_PUBLIC_URL=http://YOUR_VPS_IP:1031

# ── API ──
# REPLACE WITH YOUR VPS PUBLIC IP (e.g., http://34.93.217.29:3002/api)
NEXT_PUBLIC_API_URL=http://YOUR_VPS_IP:3002/api

# ── Module Specs (update after contract deployment) ──
NEXT_PUBLIC_TEACHER_MOD_SPEC=
NEXT_PUBLIC_STUDENT_MOD_SPEC=
NEXT_PUBLIC_QUIZ_MOD_SPEC=
NEXT_PUBLIC_QUIZ_ATTEMPT_MOD_SPEC=
NEXT_PUBLIC_PAYMENT_MOD_SPEC=
NEXT_PUBLIC_QUIZ_ACCESS_MOD_SPEC=
NEXT_PUBLIC_QUIZ_ACCESS_SALE_MOD_SPEC=
