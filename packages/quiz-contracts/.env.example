# Bitcoin Computer Configuration
# Copy this file to .env and update values as needed

# Valid chains: LTC, BTC, DOGE, PEPE (not BSV)
NEXT_PUBLIC_CHAIN=LTC

# Valid networks: mainnet, testnet, regtest
NEXT_PUBLIC_NETWORK=regtest

# Bitcoin Computer Node URLs:
# Local node (requires running Bitcoin Computer Node): http://localhost:1031
# Remote LTC regtest node: https://rltc.node.bitcoincomputer.io  
# Remote BTC testnet node: https://rbtc-testnet.node.bitcoincomputer.io
NEXT_PUBLIC_URL=https://rltc.node.bitcoincomputer.io

# BIP32 derivation path
# LTC: m/44'/1'/0'/0 (Litecoin)2
# BTC: m/44'/0'/0'/0 (Bitcoin)
NEXT_PUBLIC_PATH=m/44'/1'/0'/0

# Optional: Set specific mnemonic for reproducible testing
# Leave empty to auto-generate random mnemonic
# MNEMONIC=abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about