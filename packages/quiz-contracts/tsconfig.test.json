{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "skipLibCheck": true,
    "target": "ES2020",
    "module": "esnext",
    "moduleResolution": "node",
    "types": ["mocha", "chai", "node"]
  },
  "include": ["src/**/*", "test/**/*", "test/**/*.test.ts"],
  "exclude": ["node_modules", "dist", "src/scripts/**/*"]
}